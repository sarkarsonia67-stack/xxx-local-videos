{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['uid','name','email','createdAt','role'])"
      }
    },
    "videos": {
      ".read": true,
      "$videoId": {
        ".write": "auth != null && ((!data.exists() && newData.child('userId').val() === auth.uid) || (data.child('userId').val() === auth.uid) || root.child('admins').child(auth.uid).val() === true)",
        ".validate": "newData.hasChildren(['id','userId','title','description','tags','status','views','likes','videoUrl','createdAt'])",
        "views": {
          ".write": "auth != null"
        },
        "likes": {
          ".write": "auth != null"
        },
        "comments": {
          "$commentId": {
            ".write": "auth != null && ((!data.exists() && newData.child('userId').val() === auth.uid) || root.child('admins').child(auth.uid).val() === true)"
          }
        }
      }
    },
    "bankRequests": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)"
      }
    },
    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": false
    }
  }
}
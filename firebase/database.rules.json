{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')"
      }
    },
    "videos": {
      ".read": true,
      "$videoId": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (!data.exists() && newData.child('userId').val() === auth.uid) || (data.child('userId').val() === auth.uid && newData.child('status').val() === data.child('status').val()))"
      }
    },
    "comments": { ".read": true, "$videoId": { "$commentId": { ".write": "auth != null && (!data.exists() || data.child('userId').val() === auth.uid)" } } },
    "likes": { ".read": true, "$videoId": { "$uid": { ".write": "auth != null && auth.uid === $uid" } } },
    "settings": { ".read": true, ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'" },
    "bankVerification": { ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'", ".write": "auth != null" },
    "payouts": { ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'", ".write": "auth != null" }
  }
}
